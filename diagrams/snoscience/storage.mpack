1" x="341.7842" y="872.5513">predict</text></g><g class="message" data-participant-1="network" data-participant-2="user"><polygon fill="#E7E7E7" points="59.2681,915.75,49.2681,919.75,59.2681,923.75,55.2681,919.75" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="53.2681" x2="323.7842" y1="919.75" y2="919.75"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="116.6763" x="65.2681" y="914.6841">return predictions</text></g><path d="M20,941.75 L84.4429,941.75 L84.4429,948.8828 L74.4429,958.8828 L20,958.8828 L20,941.75" fill="#555555" style="stroke:#FFFFFF;stroke-width:1.5;"/><rect fill="none" height="46.2656" style="stroke:#FFFFFF;stroke-width:1.5;" width="355.2114" x="20" y="941.75"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="bold" lengthAdjust="spacing" textLength="19.4429" x="35" y="954.8169">alt</text><text fill="#FFFFFF" font-family="sans-serif" font-size="11" font-weight="bold" lengthAdjust="spacing" textLength="120.7368" x="99.4429" y="953.9604">[incorrect samples]</text><g class="message" data-participant-1="network" data-participant-2="user"><polygon fill="#FF0000" points="59.2681,976.0156,49.2681,980.0156,59.2681,984.0156,55.2681,980.0156" style="stroke:#FF0000;stroke-width:1;"/><line style="stroke:#FF0000;stroke-width:1;stroke-dasharray:2,2;" x1="53.2681" x2="328.7842" y1="980.0156" y2="980.0156"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="160.1768" x="65.2681" y="974.9497">report incorrect samples</text></g></g></svg>Ù€a3dc4e5192ec7e77ed89f4f40c7f6df3339f80ad078e5a1b1279b40deeecc55f756fe2f73fe8e0fccd53c61da88166a1cb2a670304042d620bd9f43d3abe7ac0ƒ¦schemeÚÝ!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
participant network
participant layer

== initialisation ==

activate network

loop for layer in layers
    network -> layer: initialise command
    deactivate network
    
    activate layer
    network <-- layer: report ready
    deactivate layer
    activate network
end

== training ==

loop for epoch in epochs
    loop for layer in layers
        network -> layer: calculate inputs
        deactivate network
        
        activate layer
        layer -> layer: calculate inputs
        network <-- layer: report ready
        deactivate layer
        
        activate network
        network -> layer: calculate outputs
        deactivate network
        
        activate layer
        layer -> layer: calculate outputs
        network <-- layer: report ready
        deactivate layer
        
        activate network
        network -> layer: calculate output derivatives
        deactivate network
        
        activate layer
        layer -> layer: calculate output derivatives
        network <-- layer: report ready
        deactivate layer
    
        activate network    
    end
    
    network -> network: calculate loss
    network -> network: calculate loss derivative
    
    loop for layer in layers
        network -> layer: train neurons
        deactivate network
        
        activate layer
        layer -> layer: train neurons
        network <-- layer: report ready
        deactivate layer
        activate network
    end
end

== prediction ==

loop for layer in layers
    network -> layer: calculate inputs
    deactivate network
    
    activate layer
    layer -> layer: calculate inputs
    network <-- layer: report ready
    deactivate layer
    
    activate network
    network -> layer: calculate outputs
    deactivate network
    
    activate layer
    layer -> layer: calculate outputs
    network <- layer: return outputs
    deactivate layer  
