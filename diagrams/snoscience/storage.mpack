troke-dasharray:2,2;" x1="75.4272" x2="275.3955" y1="960.8828" y2="960.8828"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="81.377" x="87.4272" y="955.8169">report ready</text></g><g class="message" data-participant-1="network" data-participant-2="layer"><polygon fill="#E7E7E7" points="259.3955,986.0156,269.3955,990.0156,259.3955,994.0156,263.3955,990.0156" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="65.4272" x2="265.3955" y1="990.0156" y2="990.0156"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="72.4272" y="984.9497">calculate outputs</text></g><g class="message" data-participant-1="layer" data-participant-2="layer"><line style="stroke:#E7E7E7;stroke-width:1;" x1="281.3955" x2="323.3955" y1="1019.1484" y2="1019.1484"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="323.3955" x2="323.3955" y1="1019.1484" y2="1032.1484"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="282.3955" x2="323.3955" y1="1032.1484" y2="1032.1484"/><polygon fill="#E7E7E7" points="292.3955,1028.1484,282.3955,1032.1484,292.3955,1036.1484,288.3955,1032.1484" style="stroke:#E7E7E7;stroke-width:1;"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="288.3955" y="1014.0825">calculate outputs</text></g><g class="message" data-participant-1="layer" data-participant-2="network"><polygon fill="#E7E7E7" points="76.4272,1057.2813,66.4272,1061.2813,76.4272,1065.2813,72.4272,1061.2813" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="70.4272" x2="275.3955" y1="1061.2813" y2="1061.2813"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="94.0469" x="82.4272" y="1056.2153">return outputs</text></g></g></svg>Ù€c74e3ea136230c7008f23ec3bd60d5d1b94a508ed9f39c31e00ee4b1e381cb659cde45334cc34ce88181663ed97cbf8e4c3fafca6add16513ce8c168da718867ƒ¦schemeÚÓ!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
participant layer
participant neuron

== initialisation ==

activate layer

loop for neuron in neurons
    layer -> neuron: initialise command
    deactivate layer
    
    activate neuron
    layer <-- neuron: report ready
    deactivate neuron
    activate layer
end

== training ==

loop for epoch in epochs
    loop for neuron in neurons
        layer -> neuron: calculate inputs
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate inputs
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate outputs
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate outputs
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate output derivatives
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate output derivatives
        layer <-- neuron: report ready
        deactivate neuron
    
        activate layer
    end
    
    layer -> layer: calculate total derivative (layer)
    
    loop for neuron in neurons
        layer -> neuron: calculate total derivative
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate total derivative
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate weights and bias
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate weights and bias
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
    end
end

== prediction ==

loop for neuron in neurons
    layer -> neuron: calculate inputs
    deactivate layer
    
    activate neuron
    neuron -> neuron: calculate inputs
    layer <-- neuron: report ready
    deactivate neuron
    
    activate layer
    layer -> neuron: calculate outputs
    deactivate layer
    
    activate neuron
    neuron -> neuron: calculate outputs
    layer <- neuron: return outputs
    deactivate neuron
