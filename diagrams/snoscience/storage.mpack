;stroke-width:1;" x1="54.5615" x2="286.4946" y1="1048.2813" y2="1048.2813"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="61.5615" y="1043.2153">calculate outputs</text></g><g class="message" data-participant-1="neuron" data-participant-2="neuron"><line style="stroke:#181818;stroke-width:1;" x1="302.4946" x2="344.4946" y1="1077.4141" y2="1077.4141"/><line style="stroke:#181818;stroke-width:1;" x1="344.4946" x2="344.4946" y1="1077.4141" y2="1090.4141"/><line style="stroke:#181818;stroke-width:1;" x1="303.4946" x2="344.4946" y1="1090.4141" y2="1090.4141"/><polygon fill="#181818" points="313.4946,1086.4141,303.4946,1090.4141,313.4946,1094.4141,309.4946,1090.4141" style="stroke:#181818;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="309.4946" y="1072.3481">calculate outputs</text></g><g class="message" data-participant-1="neuron" data-participant-2="layer"><polygon fill="#181818" points="65.5615,1115.5469,55.5615,1119.5469,65.5615,1123.5469,61.5615,1119.5469" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="59.5615" x2="296.4946" y1="1119.5469" y2="1119.5469"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="94.0469" x="71.5615" y="1114.481">return outputs</text></g></g></svg>Ù€15be12b454e86320b0b517451e0a0658de5a8e05f07f9f85db0111da4a0136d71a0a69afd3ad7f29eef7742588ac3dc5e4c05228eaf39d36d20b8d39be2d2685ƒ¦schemeÚÒ!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/dark.puml
participant layer
participant neuron

== initialisation ==

activate layer

loop for neuron in neurons
    layer -> neuron: initialise command
    deactivate layer
    
    activate neuron
    layer <-- neuron: report ready
    deactivate neuron
    activate layer
end

== training ==

loop for epoch in epochs
    loop for neuron in neurons
        layer -> neuron: calculate inputs
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate inputs
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate outputs
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate outputs
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate output derivatives
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate output derivatives
        layer <-- neuron: report ready
        deactivate neuron
    
        activate layer
    end
    
    layer -> layer: calculate total derivative (layer)
    
    loop for neuron in neurons
        layer -> neuron: calculate total derivative
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate total derivative
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
        layer -> neuron: calculate weights and bias
        deactivate layer
        
        activate neuron
        neuron -> neuron: calculate weights and bias
        layer <-- neuron: report ready
        deactivate neuron
        
        activate layer
    end
end

== prediction ==

loop for neuron in neurons
    layer -> neuron: calculate inputs
    deactivate layer
    
    activate neuron
    neuron -> neuron: calculate inputs
    layer <-- neuron: report ready
    deactivate neuron
    
    activate layer
    layer -> neuron: calculate outputs
    deactivate layer
    
    activate neuron
    neuron -> neuron: calculate outputs
    layer <- neuron: return outputs
    deactivate neuron
end¤mode¤dark§diagramÚc“<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="SEQUENCE" height="1179px" preserveAspectRatio="xMidYMid meet" style="width:540px;height:1179px;background:#1B1B1B;" version="1.1" viewBox="0 0 540 1179" width="540px" zoomAndPan="magnify" class="diagram"><defs/><g><rect fill="#1B1B1B" height="1179" style="stroke:none;stroke-width:1;" width="540" x="0" y="0"/><g><title>layer</title><rect fill="#313139" height="88.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="46.2969"/></g><g><title>layer</title><rect fill="#313139" height="127.5313" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="163.8281"/></g><g><title>layer</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="362.625"/></g><g><title>layer</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="463.0234"/></g><g><title>layer</title><rect fill="#313139" height="102.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="563.4219"/></g><g><title>layer</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="737.0859"/></g><g><title>layer</title><rect fill="#313139" height="110.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="837.4844"/></g><g><title>layer</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="49.5615" y="1019.1484"/></g><g><title>neuron</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="292.4946" y="134.6953"/></g><g><title>neuron</title><rect fill="#313139" height="71.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="292.4946" y="291.3594"/></g><g><title>neuron</title><rect fill="#313139" height="71.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="292.4