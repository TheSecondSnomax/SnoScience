actor user
participant network

== initialisation ==

activate user
user -> network: initialise command
deactivate user

alt supported configuration
    activate network
    user <-- network: report ready
end

alt unsupported loss function
    user <-[#red]- network: report unsupported loss function
end

alt unsupported optimiser
    user <-[#red]- network: report unsupported optimiser
    deactivate network
    activate user
end

loop for all layers
    
    user -> network: add layer
    deactivate user
    
    activate network
    
    alt supported configuration
        user <-- network: report ready
    end
    
    alt unsupported activation function
        user <-[#red]- network: report unsupported activation function
        deactivate network
        activate user
    end

end

== training ==

user -> network: train command
deactivate user

activate network

alt correct samples
    network -> network: train
    user <-- network: report finished
end

alt incorrect samples
    user <-[#red]- network: report incorrect samples
    deactivate network
    activate user
end

== prediction ==

user -> network: predict command
deactivate user

activate network

alt correct samples
    network -> network: predict
    user <- network: return predictions
end

alt incorrect samples
    user <-[#red]- network: report incorrect samples
    deactivate network
end¤mode¤dark§diagramÚT\<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="SEQUENCE" height="1085px" preserveAspectRatio="xMidYMid meet" style="width:426px;height:1085px;background:#1B1B1B;" version="1.1" viewBox="0 0 426 1085" width="426px" zoomAndPan="magnify" class="diagram"><defs/><g><rect fill="#1B1B1B" height="1085" style="stroke:none;stroke-width:1;" width="426" x="0" y="0"/><g><title>user</title><rect fill="#313139" height="64.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="43.2681" y="91.2969"/></g><g><title>user</title><rect fill="#313139" height="60.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="43.2681" y="329.3594"/></g><g><title>user</title><rect fill="#313139" height="86.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="43.2681" y="503.1563"/></g><g><title>user</title><rect fill="#313139" height="79.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="43.2681" y="745.0859"/></g><g><title>network</title><rect fill="#313139" height="173.7969" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="324.7842" y="155.5625"/></g><g><title>network</title><rect fill="#313139" height="113.5313" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="324.7842" y="389.625"/></g><g><title>network</title><rect fill="#313139" height="155.6641" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="324.7842" y="589.4219"/></g><g><title>network</title><rect fill="#313139" height="155.6641" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="324.7842" y="824.3516"/></g><rect fill="none" height="46.2656" style="stroke:#FFFFFF;stroke-width:1.5;" width="355.2114" x="20" y="170.5625"/><rect fill="none" height="46.2656" style="stroke:#FFFFFF;stroke-width:1.5;" width="355.2114" x="20" y="230.8281"/><rect fill="none" height="46.2656" style="stroke:#FFFFFF;stroke-width:1.5;" width="355.2114" x="20" y="291.0938"/><rect fill="none" height="166.7969" style="stroke:#FFFFF