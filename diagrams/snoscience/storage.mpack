00" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="81.377" x="87.4272" y="955.8169">report ready</text></g><g class="message" data-participant-1="network" data-participant-2="layer"><polygon fill="#181818" points="259.3955,986.0156,269.3955,990.0156,259.3955,994.0156,263.3955,990.0156" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="65.4272" x2="265.3955" y1="990.0156" y2="990.0156"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="72.4272" y="984.9497">calculate outputs</text></g><g class="message" data-participant-1="layer" data-participant-2="layer"><line style="stroke:#181818;stroke-width:1;" x1="281.3955" x2="323.3955" y1="1019.1484" y2="1019.1484"/><line style="stroke:#181818;stroke-width:1;" x1="323.3955" x2="323.3955" y1="1019.1484" y2="1032.1484"/><line style="stroke:#181818;stroke-width:1;" x1="282.3955" x2="323.3955" y1="1032.1484" y2="1032.1484"/><polygon fill="#181818" points="292.3955,1028.1484,282.3955,1032.1484,292.3955,1036.1484,288.3955,1032.1484" style="stroke:#181818;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="112.5693" x="288.3955" y="1014.0825">calculate outputs</text></g><g class="message" data-participant-1="layer" data-participant-2="network"><polygon fill="#181818" points="76.4272,1057.2813,66.4272,1061.2813,76.4272,1065.2813,72.4272,1061.2813" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="70.4272" x2="275.3955" y1="1061.2813" y2="1061.2813"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="94.0469" x="82.4272" y="1056.2153">return outputs</text></g></g></svg>Ù€c38bf9a84de4d2d975a0b2afc0dfa33bd99fbebc00054261027fd91c2d2e628d5192fb1f37f4d79c76aa1ba9056c5c4570b91f5cb341e16cb569b44a9710e436ƒ¦schemeÚÜ!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/dark.puml
participant network
participant layer

== initialisation ==

activate network

loop for layer in layers
    network -> layer: initialise command
    deactivate network
    
    activate layer
    network <-- layer: report ready
    deactivate layer
    activate network
end

== training ==

loop for epoch in epochs
    loop for layer in layers
        network -> layer: calculate inputs
        deactivate network
        
        activate layer
        layer -> layer: calculate inputs
        network <-- layer: report ready
        deactivate layer
        
        activate network
        network -> layer: calculate outputs
        deactivate network
        
        activate layer
        layer -> layer: calculate outputs
        network <-- layer: report ready
        deactivate layer
        
        activate network
        network -> layer: calculate output derivatives
        deactivate network
        
        activate layer
        layer -> layer: calculate output derivatives
        network <-- layer: report ready
        deactivate layer
    
        activate network    
    end
    
    network -> network: calculate loss
    network -> network: calculate loss derivative
    
    loop for layer in layers
        network -> layer: train neurons
        deactivate network
        
        activate layer
        layer -> layer: train neurons
        network <-- layer: report ready
        deactivate layer
        activate network
    end
end

== prediction ==

loop for layer in layers
    network -> layer: calculate inputs
    deactivate network
    
    activate layer
    layer -> layer: calculate inputs
    network <-- layer: report ready
    deactivate layer
    
    activate network
    network -> layer: calculate outputs
    deactivate network
    
    activate layer
    layer -> layer: calculate outputs
    network <- layer: return outputs
    deactivate layer  
end¤mode¤dark§diagramÚ]><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="SEQUENCE" height="1121px" preserveAspectRatio="xMidYMid meet" style="width:519px;height:1121px;background:#1B1B1B;" version="1.1" viewBox="0 0 519 1121" width="519px" zoomAndPan="magnify" class="diagram"><defs/><g><rect fill="#1B1B1B" height="1121" style="stroke:none;stroke-width:1;" width="519" x="0" y="0"/><g><title>network</title><rect fill="#313139" height="88.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="46.2969"/></g><g><title>network</title><rect fill="#313139" height="127.5313" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="163.8281"/></g><g><title>network</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="362.625"/></g><g><title>network</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="463.0234"/></g><g><title>network</title><rect fill="#313139" height="144.5313" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="563.4219"/></g><g><title>network</title><rect fill="#313139" height="110.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="779.2188"/></g><g><title>network</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="60.4272" y="960.8828"/></g><g><title>layer</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="271.3955" y="134.6953"/></g><g><title>layer</title><rect fill="#313139" height="71.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="271.3955" y="291.3594"/></g><g><title>layer</title><rect fill="#313139" height="71.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="271.3955" y="391.7578"/></g><g><title>layer</title><rect fill="#313139" height="71.2656" style="stroke:#E7E7E7;stroke-width:1;" width="1