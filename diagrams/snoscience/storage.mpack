†Ù€cf2cf8490bd5260d4d1fcd1476d10e5d38b007aa568a7f124ad1441b49c2abb851e38ae1c24199f63c9c6530e9e2ef0884938aa25191edb529e4b1dc29531dc0ƒ¦schemeÚË!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
actor user
participant network

== initialisation ==

activate user
user -> network: initialise command
deactivate user

alt supported configuration
    activate network
    user <-- network: report ready
end

alt unsupported loss function
    user <-[#red]- network: report unsupported loss function
end

alt unsupported optimiser
    user <-[#red]- network: report unsupported optimiser
    deactivate network
    activate user
end

loop for all layers
    
    user -> network: add layer
    deactivate user
    
    activate network
    
    alt supported configuration
        user <-- network: report ready
    end
    
    alt unsupported activation function
        user <-[#red]- network: report unsupported activation function
        deactivate network
        activate user
    end

end

== training ==

user -> network: train command
deactivate user

activate network

alt correct samples
    network -> network: train
    user <-- network: report finished
end

alt incorrect samples
    user <-[#red]- network: report incorrect samples
    deactivate network
    activate user
end

== prediction ==

user -> network: predict command
deactivate user

activate network

alt correct samples
    network -> network: predict
    user <- network: return predictions
end

alt incorrect samples
    user <-[#red]- network: report incorrect samples
    deactivate network
end¤mode¥light§diagramÚSü<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="SEQUENCE" height="1085px" preserveAspectRatio="xMidYMid meet" style="width:426px;height:1085px;background:#FFFFFF;" version="1.1" viewBox="0 0 426 1085" width="426px" zoomAndPan="magnify" class="diagram"><defs/><g><g><title>user</title><rect fill="#F1F1F1" height="64.2656" style="stroke:#181818;stroke-width:1;" width="10" x="43.2681" y="91.2969"/></g><g><title>user</title><rect fill="#F1F1F1" height="60.2656" style="stroke:#181818;stroke-width:1;" width="10" x="43.2681" y="329.3594"/></g><g><title>user</title><rect fill="#F1F1F1" height="86.2656" style="stroke:#181818;stroke-width:1;" width="10" x="43.2681" y="503.1563"/></g><g><title>user</title><rect fill="#F1F1F1" height="79.2656" style="stroke:#181818;stroke-width:1;" width="10" x="43.2681" y="745.0859"/></g><g><title>network</title><rect fill="#F1F1F1" height="173.7969" style="stroke:#181818;stroke-width:1;" width="10" x="324.7842" y="155.5625"/></g><g><title>network</title><rect fill="#F1F1F1" height="113.5313" style="stroke:#181818;stroke-width:1;" width="10" x="324.7842" y="389.625"/></g><g><title>network</title><rect fill="#F1F1F1" height="155.6641" style="stroke:#181818;stroke-width:1;" width="10" x="324.7842" y="589.4219"/></g><g><title>network</title><rect fill="#F1F1F1" height="155.6641" style="stroke:#181818;stroke-width:1;" width="10" x="324.7842" y="824.3516"/></g><rect fill="none" height="46.2656" style="stroke:#000000;stroke-width:1.5;" width="355.2114" x="20" y="170.5625"/><rect fill="none" height="46.2656" style="stroke:#000000;stroke-width:1.5;" width="355.2114" x="20" y="230.8281"/><rect fill="none" height="46.2656" style="stroke:#000000;stroke-width:1.5;" width="355.2114" x="20" y="291.0938"/><rect fill="none" height="166.7969" style="stroke:#000000;stroke-width:1.5;" width="375.2114" x="10" y="351.3594"/><rect fill="none" height="46.2656" s